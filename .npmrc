# npm 10's arborist crashes with "Cannot read properties of null (reading 'edgesOut')"
# while resolving Vitest's optional peer graph. This is an npm bug, not a real conflict:
# every peer resolves correctly once installed. Committed so that local, CI and
# Cloudflare Workers Builds all install the same way. See docs/DECISIONS.md.
legacy-peer-deps=true
