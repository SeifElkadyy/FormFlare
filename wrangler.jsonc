{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formflare",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,

  // Set explicitly rather than relying on the default. A fresh account deployed via the
  // button came up with no workers.dev URL at all, which leaves a deployer with a
  // Worker they cannot reach and no obvious fix.
  "workers_dev": true,

  // Preview URLs are public and hit the *same* D1 database as production, so an older
  // version would stay reachable — with real submissions — on a URL that never expires
  // and misses later fixes. Not worth it for an app holding other people's form data.
  "preview_urls": false,

  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },

  "observability": { "enabled": true },
  "upload_source_maps": true,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "formflare",
      "migrations_dir": "drizzle/migrations"
    }
  ],

  // No r2_buckets entry on purpose.
  //
  // Activating R2 requires a payment method on the Cloudflare account, even to stay
  // inside the free tier — so listing it here makes the Deploy button demand a card
  // before anyone can finish, for a feature most forms never use.
  //
  // File uploads are therefore opt-in: add a BUCKET binding yourself and redeploy, and
  // the app picks it up automatically. Everything else (forms, waitlists, webhooks,
  // email, exports) works without it. See docs/deployment.md.

  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "formflare-jobs" }],
    "consumers": [
      {
        "queue": "formflare-jobs",
        "max_batch_size": 10,
        "max_retries": 5
      }
    ]
  },

  // Optional at runtime: the app degrades gracefully when Email Sending is unavailable.
  // No "remote" field — not part of the documented send_email schema (see docs/DECISIONS.md).
  "send_email": [{ "name": "EMAIL" }],

  // namespace_id must be a string containing a positive integer.
  "ratelimits": [
    {
      "name": "SUBMIT_RATE_LIMIT",
      "namespace_id": "2001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "2003",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "LOGIN_RATE_LIMIT",
      "namespace_id": "2002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  "vars": {
    "APP_NAME": "FormFlare"
  },

  // Every 15 minutes: re-enqueue work stranded by an evicted Worker or a lost message.
  // Daily at 03:00: expired sessions, old delivery logs, orphaned R2 objects.
  "triggers": { "crons": ["*/15 * * * *", "0 3 * * *"] }
}
